
import "lockit_globals.scr"

sub main()
{
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_LocalPlayer_014`)
    {
        RequiresVO(true);
        Actor(`LocalPlayer`);
        Text(En, ALL, `Lovely, just me against the world again, huh?`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_Pilgrim_001`)
    {
        RequiresVO(true);
        Actor(`Pilgrim`);
        Text(En, ALL, `Aiden! Glad you're awake. Welcome to the Hotel.`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_Pilgrim_002`)
    {
        RequiresVO(true);
        Actor(`Pilgrim`);
        Text(En, ALL, `Before you get going, do you have any questions?`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_Pilgrim_007`)
    {
        RequiresVO(true);
        Actor(`Pilgrim`);
        Text(En, ALL, `We'll start by getting the power running.`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_Pilgrim_008`)
    {
        RequiresVO(true);
        Actor(`Pilgrim`);
        Text(En, ALL, `There are some backup generators on the lower floor of the parking garage, but our scouts couldn't find a way in.`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_Pilgrim_009`)
    {
        RequiresVO(true);
        Actor(`Pilgrim`);
        Text(En, ALL, `Once the power is up, we - the support team - will use the elevator to move up through the building with you, setting up safe zones along the way.`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_Pilgrim_010`)
    {
        RequiresVO(true);
        Actor(`Pilgrim`);
        Text(En, ALL, `The scouts inside should also be lighting the way for you, but they're not fighters.`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_Pilgrim_011`)
    {
        RequiresVO(true);
        Actor(`Pilgrim`);
        Text(En, ALL, `Ultimately we're going to be relying on you and your BMF skillset to do the heavy lifting here.`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_Pilgrim_012`)
    {
        RequiresVO(true);
        Actor(`Pilgrim`);
        Text(En, ALL, `End goal is to clear the building entirely, all the way up to the rooftop bar.`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_Pilgrim_013`)
    {
        RequiresVO(true);
        Actor(`Pilgrim`);
        Text(En, ALL, `From there our scavengers will come and pick the place clean.`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_Pilgrim_015`)
    {
        RequiresVO(true);
        Actor(`Pilgrim`);
        Text(En, ALL, `Suck it up, you survived Villedor, this should be a piece of cake.`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_Pilgrim_016`)
    {
        RequiresVO(true);
        Actor(`Pilgrim`);
        Text(En, ALL, `We've already sent a couple of scouts ahead. This is the information we have so far:`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_Pilgrim_017`)
    {
        RequiresVO(true);
        Actor(`Pilgrim`);
        Text(En, ALL, `They've managed to map out the parking garage and a small section of the lobby.`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_Pilgrim_018`)
    {
        RequiresVO(true);
        Actor(`Pilgrim`);
        Text(En, ALL, `The parking garage seems to have sustained some damage from a missile strike, but is largely intact.`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_Pilgrim_019`)
    {
        RequiresVO(true);
        Actor(`Pilgrim`);
        Text(En, ALL, `Part of the sewer has been exposed by the damage as well.`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_Pilgrim_020`)
    {
        RequiresVO(true);
        Actor(`Pilgrim`);
        Text(En, ALL, `One of the scouts tried to make their way through the sewer, but we haven't heard from them since.`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_Pilgrim_021`)
    {
        RequiresVO(true);
        Actor(`Pilgrim`);
        Text(En, ALL, `We knew before we got here that there would be a lot of infected inside.`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_Pilgrim_022`)
    {
        RequiresVO(true);
        Actor(`Pilgrim`);
        Text(En, ALL, `Rumors also say that there's a full nest... but we haven't confirmed that yet.`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_Pilgrim_023`)
    {
        RequiresVO(true);
        Actor(`Pilgrim`);
        Text(En, ALL, `The scouts have got some intel about the infected in the garage though:`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_Pilgrim_024`)
    {
        RequiresVO(true);
        Actor(`Pilgrim`);
        Text(En, ALL, `Looks like mostly run-of-the-mill biters, with a few virals mixed in.`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_Pilgrim_025`)
    {
        RequiresVO(true);
        Actor(`Pilgrim`);
        Text(En, ALL, `Aside from the gear on you, we have a travelling entourage of vendors with us today.`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_Pilgrim_026`)
    {
        RequiresVO(true);
        Actor(`Pilgrim`);
        Text(En, ALL, `The vultures *cough* ahem *clears throat* ... I mean vendors will trade with you for gear.`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_Pilgrim_027`)
    {
        RequiresVO(true);
        Actor(`Pilgrim`);
        Text(En, ALL, `They'll accompany us up through the building, so you should be able to restock wherever we manage to set up a safe zone.`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_Pilgrim_028`)
    {
        RequiresVO(true);
        Actor(`Pilgrim`);
        Text(En, ALL, `One more thing.`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_Pilgrim_029`)
    {
        RequiresVO(true);
        Actor(`Pilgrim`);
        Text(En, ALL, `The doc found some inhibitors for you to use. They should give you a little boost to get by. He needs to test them, so he'll provide a new batch as soon as he's done testing.`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_Pilgrim_030`)
    {
        RequiresVO(true);
        Actor(`Pilgrim`);
        Text(En, ALL, `Though the scouts reported wailing in the vents... so there might be a banshee around.`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_choice_003`)
    {
        RequiresVO(false);
        Actor(`LocalPlayer`);
        Text(En, ALL, `What's the plan?`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_choice_004`)
    {
        RequiresVO(false);
        Actor(`LocalPlayer`);
        Text(En, ALL, `What do we know about the layout?`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_choice_005`)
    {
        RequiresVO(false);
        Actor(`LocalPlayer`);
        Text(En, ALL, `What kind of resistance are we expecting inside?`);
    }
    Entry(`DLG_RsRlHotelDialogSpikeQ1Info_choice_006`)
    {
        RequiresVO(false);
        Actor(`LocalPlayer`);
        Text(En, ALL, `What tools do we have available?`);
    }
}
