// HL: Alyx lighting basically with 0.55 contrast and 4500 temp

// TOD: 19:30 PM Clear

VarString("s_color_grading_map", "ae_sunrise_clear_a_aclg.png")

VarFloat("f_image_contrast", 0.80)
// VarFloat("f_image_contrast", 0.85)

VarFloat("f_image_saturation", 0.80)
// VarFloat("f_image_saturation", 0.65)
// ^ actual desaturation 

VarFloat("f_camera_temperature", 4500.000000)
// ^ use with 0.55 or 0.85 contrast, 0.80 saturation, ae_sunrise color grading
VarFloat("f_noise", 0.145)
VarFloat("f_soft_glow", 0.05)
// VarFloat("f_soft_glow", 0.45)
// ^  global volumetric glow, can cause weird FPS issues sometimes though with bloom and transluscent objects

VarFloat("f_fog_far", 0.72)
VarFloat("f_fog_height", 0.72)
VarFloat("f_fog_near", 0.19)
// ^ less fog, clearer foreground

// VarFloat("f_lights_volumetric_intensity", 0.003)
VarFloat("f_lights_volumetric_intensity", 0.0015)
// ^ expensive setting I think, but it makes a really nice global volumetric glow and allows fog to interact with light
VarFloat("f_engine_visrange_dynlights", 42.0)

