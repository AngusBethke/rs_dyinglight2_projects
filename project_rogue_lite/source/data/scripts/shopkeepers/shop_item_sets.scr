	ItemSet("TR_VendorOnRaid_LowDuraWeapon")
    {
		// Tier5 weapons unlocked by default. Added in patch21.
		LootUnlockTag("tr.weapon.warsaw"); Item("wpn_1hs_mach_m_LowDurability_T5");
		LootUnlockTag("tr.weapon.meatsquasher"); Item("wpn_1hb_ham_l_LowDurability_T5");
		LootUnlockTag("tr.weapon.thirstyaxe"); Item("wpn_15hs_f_LowDurability_T5");
		LootUnlockTag("tr.weapon.thecrosier"); Item("wpn_15hb_a_LowDurability_T5");
		LootUnlockTag("tr.weapon.glaive"); Item("wpn_2hs_c_LowDurability_T5");

		// Tier7 weapons are unlocked through primary vendor. They replace Tier2 weapons one-to-one.
		// Added in patch21.
		LootUnlockTag("tr.weapon.executionersaxe"); Item("wpn_1hs_axe_b_LowDurability_T7");
		LootUnlockTag("tr.weapon.turbine"); Item("wpn_1hb_mace_f_LowDurability_T7");
		LootUnlockTag("tr.weapon.streetcleaver"); Item("wpn_15hs_a_LowDurability_T7");
		LootUnlockTag("tr.weapon.hookstick"); Item("wpn_15hb_c_LowDurability_T7");
		LootUnlockTag("tr.weapon.thingamabob"); Item("wpn_2hs_h_LowDurability_T7");

		// Tier7 elemental weapons are unlocked by default. Added in patch22.
		LootUnlockTag("tr.weapon.firemace.t7"); Item("wpn_1hb_mace_TR_fire_LowDurability_T7");
		LootUnlockTag("tr.weapon.frostmace.t7"); Item("wpn_1hb_mace_TR_ice_LowDurability_T7");
		LootUnlockTag("tr.weapon.shockmace.t7"); Item("wpn_1hb_mace_TR_shock_LowDurability_T7");

		// Tier8 elemental weapons are unlocked through primary vendor. The unlock is accessible after the 
		// corresponding Tier7 non-elemental weapon has been unlocked.
		LootUnlockTag("tr.weapon.fireaxe.t8"); Item("wpn_1hs_small_axe_TR_fire_LowDurability_T8");
		LootUnlockTag("tr.weapon.frostaxe.t8"); Item("wpn_1hs_small_axe_TR_ice_LowDurability_T8");
